# ── Nexus Platform Environment Configuration ──
# Copy this to .env and configure for your environment

PORT=3000
NODE_ENV=development

# STUN/TURN servers for WebRTC (use your own for production)
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Rate limiting
MAX_ROOMS=100
MAX_USERS_PER_ROOM=12
